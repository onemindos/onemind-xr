+// reflight: after a successful estop the sim is on the ground, disarmed. Arm and take off
+// again (A4, zeus+alice) so the browser step sees a flying drone.
+func (h *H) reflight() {
+	h.guard("reflight", func() {
+		arm, _, err := h.approve("zeus", actionReq("asset.arm", "drone", "sim-x1", map[string]any{}), "zeus", "alice")
+		if err != nil {
+			panic(err)
+		}
+		okArm := waitFor(20*time.Second, func() bool { return contains(h.r.actionEvents(arm), "executed") })
+		tko, _, err := h.approve("zeus", actionReq("asset.takeoff", "drone", "sim-x1", map[string]any{"hae_m": 60.0}), "zeus", "alice")
+		if err != nil {
+			panic(err)
+		}
+		okTko := waitFor(20*time.Second, func() bool { return contains(h.r.actionEvents(tko), "executed") })
+		h.result("reflight after estop: arm+takeoff (A4, zeus+alice)", map[bool]string{true: "pass", false: "fail"}[okArm && okTko],
+			fmt.Sprintf("arm %v; takeoff %v", h.r.actionEvents(arm), h.r.actionEvents(tko)), nil)
+	})
+}
