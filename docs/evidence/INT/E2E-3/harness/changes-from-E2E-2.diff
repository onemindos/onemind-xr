+// step5b: the D2-P14 race (a bridge report beating the dispatch audit) was intermittent, so
+// "evt.mission.{task}.sent always present" is probed with several more human-confirmed gotos.
+func (h *H) step5b() {
+	h.guard("5b repeat", func() {
+		const n = 5
+		var outs []string
+		bad := 0
+		for i := 0; i < n; i++ {
+			tsk := newID("tsk")
+			glat, glon := destination(HOME[0], HOME[1], float64(72*i), 350)
+			body := actionReq("task.assign", "drone", "sim-x1", map[string]any{"task_id": tsk, "parent_id": nil,
+				"type": "onemind.task.goto.v1", "spec": map[string]any{"lat": glat, "lon": glon, "hae_m": 60.0}})
+			act, _, err := h.approve("zeus", body, "zeus")
+			if err != nil {
+				outs = append(outs, fmt.Sprintf("#%d %s: %v", i, tsk, err))
+				bad++
+				continue
+			}
+			var st map[string]any
+			ok := waitFor(60*time.Second, func() bool {
+				e, err := h.kvGet("mission-state", tsk)
+				if err != nil {
+					return false
+				}
+				st, _ = e["status"].(map[string]any)
+				s, _ := st["state"].(string)
+				return s == "done_ok" || s == "done_not_ok"
+			})
+			time.Sleep(300 * time.Millisecond)
+			var f []string
+			for _, m := range h.r.find("evt.mission."+tsk+".", nil) {
+				f = append(f, strings.TrimPrefix(m.Subject, "evt.mission."+tsk+"."))
+			}
+			good := ok && st["state"] == "done_ok" && contains(f, "sent") && indexOf(f, "sent") < indexOf(f, "received") && dget(st, "result", "source") == "bridge"
+			if !good {
+				bad++
+			}
+			outs = append(outs, fmt.Sprintf("#%d %s action %s: state=%v facts=%v result=%s ok=%v", i, tsk, act, st["state"], f, trunc(dget(st, "result")), good))
+		}
+		h.result("5b repeat: 5 more human-confirmed goto tasks each reach done_ok from the bridge with evt.mission.{task}.sent before received",
+			map[bool]string{true: "pass", false: "fail"}[bad == 0], strings.Join(outs, " | "), nil)
+	})
+}
+
+// sentInvariant: every task the bus saw a lifecycle report for also has evt.mission.{task}.sent.
+func (h *H) sentInvariant(label string) {
+	h.guard("sent invariant", func() {
+		seen := map[string][]string{}
+		var order []string
+		for _, m := range h.r.find("evt.mission.tsk-", nil) {
+			parts := strings.Split(m.Subject, ".")
+			if len(parts) != 4 {
+				continue
+			}
+			if _, ok := seen[parts[2]]; !ok {
+				order = append(order, parts[2])
+			}
+			seen[parts[2]] = append(seen[parts[2]], parts[3])
+		}
+		var missing []string
+		n := 0
+		for _, t := range order {
+			f := seen[t]
+			if contains(f, "received") || contains(f, "executing") || contains(f, "done_ok") || contains(f, "done_not_ok") {
+				n++
+				if !contains(f, "sent") {
+					missing = append(missing, fmt.Sprintf("%s %v", t, f))
+				}
+			}
+		}
+		h.result("invariant ("+label+"): every reported task has evt.mission.{task}.sent", map[bool]string{true: "pass", false: "fail"}[len(missing) == 0],
+			fmt.Sprintf("%d reported tasks, missing sent: %v", n, missing), nil)
+	})
+}
